generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String          @id @default(cuid())
  name        String
  email       String          @unique
  password    String
  errands     Errand[]
  tags        Tag[]
  categories  Category[]
  notes       Note[]
  reminders   Reminder[]
  dashboard   DashboardWidget?
  settings    UserSettings?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Errand {
  id              String      @id @default(cuid())
  title           String
  description     String?
  status          String      @default("open") // open | in_progress | completed | cancelled
  priority        String      @default("medium") // low | medium | high
  dueDate         DateTime?
  estimatedMinutes Int?       // estimated time in minutes
  sortOrder       Int         @default(0)
  progress        Int         @default(0) // 0-100
  categoryId      String?
  category        Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  tags            ErrandTag[]
  subtasks        Subtask[]
  activities      Activity[]
  notes           Note[]
  reminders       Reminder[]
  recurrenceRule  String?     // daily | weekly | monthly
  completedAt     DateTime?
  reminderMinutes Int?        // minutes before due date to remind
  deletedAt       DateTime?   // soft delete
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([sortOrder])
  @@index([categoryId])
  @@index([dueDate])
}

model Tag {
  id       String      @id @default(cuid())
  name     String
  color    String      @default("#8b5cf6")
  userId   String?
  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  errands  ErrandTag[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([name, userId])
  @@index([userId])
}

model ErrandTag {
  errandId String
  tagId    String
  errand   Errand  @relation(fields: [errandId], references: [id], onDelete: Cascade)
  tag      Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([errandId, tagId])
}

model Subtask {
  id        String  @id @default(cuid())
  title     String
  completed Boolean @default(false)
  sortOrder Int     @default(0)
  errandId  String
  errand    Errand  @relation(fields: [errandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([errandId])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  color     String    @default("#8b5cf6")
  icon      String    @default("folder") // lucide icon name
  sortOrder Int       @default(0)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  errands   Errand[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, userId])
  @@index([userId])
}

model Note {
  id        String   @id @default(cuid())
  content   String
  errandId  String
  errand    Errand  @relation(fields: [errandId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([errandId])
}

model UserSettings {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultView String   @default("all")
  defaultSort String   @default("newest")
  showCharts  Boolean  @default(true)
  compactMode Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Activity {
  id        String   @id @default(cuid())
  action    String   // created | updated | deleted | status_changed | completed | reopened
  details   String?
  errandId  String?
  errand    Errand?  @relation(fields: [errandId], references: [id], onDelete: SetNull)
  userId    String?
  createdAt DateTime @default(now())

  @@index([errandId])
  @@index([createdAt])
}

model Reminder {
  id          String   @id @default(cuid())
  type        String   @default("due_date") // due_date | custom
  scheduledAt DateTime
  triggered   Boolean  @default(false)
  errandId    String
  errand      Errand   @relation(fields: [errandId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([errandId])
  @@index([scheduledAt])
  @@index([triggered])
}

model DashboardWidget {
  id        String   @id @default(cuid())
  type      String   // completion_ring | status_chart | priority_chart | trend_chart | category_chart | recent_activity | quick_stats
  position  Int      @default(0)
  visible   Boolean  @default(true)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}